#[allow(unused)]
mod __test {
    impl htmxology::Route for MyRoute {
        fn method(&self) -> htmxology::__private::http::Method {
            match self {
                Self::User { .. } => htmxology::__private::http::Method::GET,
            }
        }
    }
    impl ::std::fmt::Display for MyRoute {
        fn fmt(&self, f: &mut ::std::fmt::Formatter<'_>) -> ::std::fmt::Result {
            match self {
                Self::User { user_id } => {
                    ::std::fmt::Write::write_char(f, '/')?;
                    f.write_str("users")?;
                    ::std::fmt::Write::write_char(f, '/')?;
                    htmxology::PathSegment(&user_id).fmt(f)?;
                }
            };
            Ok(())
        }
    }
    impl ::std::str::FromStr for MyRoute {
        type Err = htmxology::ParseError;
        fn from_str(__s: &str) -> Result<Self, Self::Err> {
            {
                static RE: ::std::sync::LazyLock<htmxology::__private::regex::Regex> = ::std::sync::LazyLock::new(||
                {
                    htmxology::__private::regex::Regex::new(
                            "^/users/(?P<user_id>[^/]+)$",
                        )
                        .unwrap()
                });
                let (__path, __query_str): (&str, &str) = match __s.split_once('?') {
                    Some((p, q)) => (p, q),
                    None => (__s, ""),
                };
                if let Some(__captures) = RE.captures(__path) {
                    return Ok({
                        let user_id: u32 = htmxology::parse_path_param(
                            stringify!(user_id),
                            __captures
                                .name(stringify!(user_id))
                                .ok_or_else(|| htmxology::ParseError::MissingPathParam {
                                    param_name: stringify!(user_id).to_string(),
                                })?
                                .as_str(),
                        )?;
                        Self::User { user_id }
                    });
                }
            }
            Err(htmxology::ParseError::NoMatchingRoute {
                url: __s.to_string(),
            })
        }
    }
    impl<S: Send + Sync> htmxology::__private::axum::extract::FromRequest<S>
    for MyRoute {
        type Rejection = htmxology::__private::axum::response::Response;
        async fn from_request(
            __req: htmxology::__private::axum::extract::Request,
            __state: &S,
        ) -> Result<Self, Self::Rejection> {
            use htmxology::__private::axum::extract::FromRequest as _;
            use htmxology::__private::axum::extract::FromRequestParts as _;
            use htmxology::__private::axum::response::IntoResponse as _;
            {
                static RE: ::std::sync::LazyLock<htmxology::__private::regex::Regex> = ::std::sync::LazyLock::new(||
                {
                    htmxology::__private::regex::Regex::new(
                            "^/users/(?P<user_id>[^/]+)$",
                        )
                        .unwrap()
                });
                if let Some(__captures) = RE.captures(&__req.uri().path()) {
                    return match __req.method() {
                        &htmxology::__private::http::Method::GET => {
                            Ok({
                                let user_id = htmxology::decode_path_argument(
                                    stringify!(user_id),
                                    &__captures[stringify!(user_id)],
                                )?;
                                Self::User { user_id }
                            })
                        }
                        _ => {
                            Err(
                                htmxology::__private::http::StatusCode::METHOD_NOT_ALLOWED
                                    .into_response(),
                            )
                        }
                    };
                }
            }
            Err(htmxology::__private::http::StatusCode::NOT_FOUND.into_response())
        }
    }
