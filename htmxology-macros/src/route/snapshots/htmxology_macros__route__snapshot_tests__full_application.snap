        fn method(&self) -> htmxology::__private::http::Method {
            match self {
                Self::Home => htmxology::__private::http::Method::GET,
                Self::UserProfile { .. } => htmxology::__private::http::Method::GET,
                Self::Search { .. } => htmxology::__private::http::Method::GET,
                Self::DeletePost { .. } => htmxology::__private::http::Method::DELETE,
                Self::Login { .. } => htmxology::__private::http::Method::POST,
                Self::Admin { route, .. } => route.method(),
                Self::NotFound(catch_all) => catch_all.method(),
            }
        }
    }
    impl ::std::fmt::Display for AppRoute {
        fn fmt(&self, f: &mut ::std::fmt::Formatter<'_>) -> ::std::fmt::Result {
            match self {
                Self::Home => {
                    ::std::fmt::Write::write_char(f, '/')?;
                }
                Self::UserProfile { user_id } => {
                    ::std::fmt::Write::write_char(f, '/')?;
                    f.write_str("users")?;
                    ::std::fmt::Write::write_char(f, '/')?;
                    htmxology::PathSegment(&user_id).fmt(f)?;
                }
                Self::Search { q } => {
                    ::std::fmt::Write::write_char(f, '/')?;
                    f.write_str("search")?;
                    let qs = &htmxology::__private::serde_html_form::to_string(&q)
                        .map_err(|_| ::std::fmt::Error)?;
                    if !qs.is_empty() {
                        ::std::fmt::Write::write_char(f, '?')?;
                        f.write_str(&qs)?;
                    }
                }
                Self::DeletePost { post_id } => {
                    ::std::fmt::Write::write_char(f, '/')?;
                    f.write_str("posts")?;
                    ::std::fmt::Write::write_char(f, '/')?;
                    htmxology::PathSegment(&post_id).fmt(f)?;
                }
                Self::Login { credentials: _ } => {
                    ::std::fmt::Write::write_char(f, '/')?;
                    f.write_str("login")?;
                }
                Self::Admin { route } => {
                    ::std::fmt::Write::write_char(f, '/')?;
                    f.write_str("admin")?;
                    route.fmt(f)?;
                }
                Self::NotFound(catch_all) => catch_all.fmt(f)?,
            };
            Ok(())
        }
    }
